 ; the doors
 [Prop [[Name UpperDoor] [Appearance [Some [Composed SteelWallDoor []]]] [Place [[Against [Some South]] [Along 0.6]]]
   [Interact [Some [[InteractionType Open] [Cue [Enter [[To [Dorm Stairwell]] [Style SteelDoor]]]]]]]]]
 [Prop [[Name RaOfficeDoor] [Appearance [Some [Composed WoodenWallDoor []]]] [Place [[Against [Some West]] [Along -4]]]
   [Interact [Some [[InteractionType Open] [Cue [Enter [[To [Dorm RaOffice]] [Style WoodenDoor] [Opens [Some [Flagged [Examined RaKeypad]]]] [Locked [Some "The RA's office. The keypad beside it holds it shut."]]]]]]]]]]
 [Prop [[Name Room212Door] [Appearance [Some [Composed WoodenWallDoor []]]] [Place [[Against [Some East]] [Along 2]]]
   [Interact [Some [[InteractionType Open] [Cue [Enter [[To [Dorm Room212]] [Style WoodenDoor]]]]]]]]]
 ; room 210's door, quiet
 [Prop [[Name Room210Door] [Appearance [Some [Composed WoodenWallDoor []]]] [Place [[Against [Some East]] [Along -4.5]]] [Spot [0 0.05]]
   [Interact [Some [[InteractionType Examine] [Cue [Say ["Room 210. Locked, and quiet. A dry-erase board on the door: 'GONE HOME - BACK SUNDAY.'"]]]]]]]]
 ; the RA's keypad - its code the year the hall opened
 [Prop [[Name RaKeypad] [Appearance [Some [Slab [[Size [0.02 0.18 0.12]] [Surface Plastic] [Tint Keypad]]]]] [Place [[At [Some [-1.58 -5.4]]] [Height [Some 1.15]]]]
   [Interact [Some [[InteractionType Use] [Cue [If [Flagged [Examined RaKeypad]]
                                         [Say ["The keypad's light is green."]]
                                         [Sequence [[Say ["A keypad beside the RA's door, its light red."]]
                                                    [Keypad [[Code "1962"] [Then [Sequence [[SetFlag [Examined RaKeypad]] [Sound LockReleaseSound] [Say ["The keypad chirps and the RA's door unlatches."]]]]]]]]]]]]]]]]

