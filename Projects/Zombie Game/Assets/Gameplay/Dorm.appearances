     [Part [[Surface Steel] [Shape PartBox] [At [0.45 0.85 -0.95]] [Size [0.05 1.7 0.05]] [Color Frame]]]
     [Part [[Surface Steel] [Shape PartBox] [At [-0.45 0.85 0.95]] [Size [0.05 1.7 0.05]] [Color Frame]]]
