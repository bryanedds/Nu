     [Part [[Surface Cloth] [Shape PartBox] [At [0 0.42 0]] [Size [0.9 0.14 1.9]] [Color Mattress]]]
     [Part [[Surface Cloth] [Shape PartBox] [At [0 1.42 0]] [Size [0.9 0.14 1.9]] [Color Mattress]]]
     [Part [[Surface Steel] [Shape PartBox] [At [0 0.33 0]] [Size [0.9 0.04 1.9]] [Color Frame]]]
     [Part [[Surface Steel] [Shape PartBox] [At [0 1.33 0]] [Size [0.9 0.04 1.9]] [Color Frame]]]
     [SolidBox [0 0] [0.47 0.98]]]]]]

