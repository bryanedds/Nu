     [LegLeft [[Spread 63.0254]]]
     [LegRight [[Spread -63.0254]]]]]]]

 ; a step of a four-legged walk - the legs moving in diagonal pairs, the left hind with the right fore and the right
 ; hind with the left fore, the body rolling a little from side to side over them and the head swaying against it
 [Cycling Stride
  [[Bob [Some [[Base -0.015] [Amplitude 0.02] [Wave Rebound] [Offset 90]]]]
   [Turns
    [[Pelvis [[Twisting [[Amplitude 3.4377]]]]]
     [Torso [[Twisting [[Amplitude -4.5837]]]]]
     [Head [[Twisting [[Amplitude 3.4377]]] [Leaning [[Base -2.8648]]]]]
     [LegLeft [[Swinging [[Amplitude 24.0642]]]]]
     [ArmRight [[Swinging [[Amplitude 24.0642]]]]]
     [LegRight [[Swinging [[Amplitude -24.0642]]]]]
     [ArmLeft [[Swinging [[Amplitude -24.0642]]]]]]]]]

 ; slow, heavy breaths, the head rising and falling with them
 [Cycling Breath [[Turns [[Head [[Leaning [[Base -2.8648] [Amplitude 3.4377]]]]]]]]]

 ; a tail's slow swish from side to side, each segment turning a little further than the one before
 [Cycling Swish [[Chains [[TailChain [[Twisting [[Amplitude 4.0107]]]]]]]]]]
