 ; the desk, its drawer's keypad
 [Prop
  [[Name Desk]
   [Appearance [Some [Composed Desk [[Colors [Some [[Wood Wood]]]] [Stretch [Some [1.6 1 0.8]]]]]]]
   [Place [[At [Some [-1.6 1.2]]] [Facing 90]]]
   ; its code the day the wing opened - the key in it left there, if there's no room for it, till there is
   [Interact
    [Some
     [[InteractionType Examine]
      [Cue
       [If
        [Flagged [Examined RecordsDrawer]]
        [If [Flagged [Taken RecordsPharmacyKey]] [Say ["The drawer's empty now."]] [GiveAs RecordsPharmacyKey PharmacyKey 1]]
        [Sequence
         [[Say ["A locked drawer in the desk, a little keypad set in its front."]]
          [Keypad
           [[Code "0314"]
            [Then
             [Sequence
              [[SetFlag [Examined RecordsDrawer]] [Sound DrawerOpenSound] [GiveAs RecordsPharmacyKey PharmacyKey 1]]]]]]]]]]]]]]]

 [Prop
  [[Name Keypad]
   [Appearance [Some [Slab [[Size [0.02 0.18 0.12]] [Surface Plastic] [Tint Keypad]]]]]
   [Place [[At [Some [-1.15 1.2]]] [Height [Some 0.51]]]]]]

 ; the pickups
 [Prop
  [[Name RecordsBullets]
   [Place [[At [Some [1.4 -2.2]]] [Height [Some 1.42]]]]
   [Interact [Some [[InteractionType Take] [Cue [PickUp [[Item HandgunBullets] [Count 15]]]]]]]]]

 ; the creatures
 [Enemy [[Name RecordsPatient] [Creature Patient] [Place [[At [Some [-1.3 -1.4]]] [Facing 68]]]]]]
