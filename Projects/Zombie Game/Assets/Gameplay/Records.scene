 [Prop
  [[Name RecordsDoor]
   [Appearance [Some [Composed WoodenWallDoor []]]]
   [Place [[Against [Some East]] [Along 0]]]
   [Interact [Some [[InteractionType Open] [Cue [Enter [[To [Hospital WestHall]] [Style WoodenDoor]]]]]]]]]

