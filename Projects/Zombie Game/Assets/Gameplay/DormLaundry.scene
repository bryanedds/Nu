; The laundry room - washers along one wall and dryers along another, a folding table, and in dryer 3 a hoodie with a
; student ID still in its pocket.

[[Palette [[Lino [0.5 0.5 0.46 1]] [Paint [0.7 0.7 0.64 1]] [Dado [0.45 0.46 0.42 1]] [Table [0.6 0.6 0.58 1]]]]

 [Area
  [[Type [Dorm Laundry]]
   [Name "Laundry Room"]
   [Ambient 0.75]
   [Probe [0 1.6 0]]
   [Bounds [[-3.5 -0.5 -3] [7 4 6]]]
   [Songs [[[Song DormSong]]]]]]

 [Layout [Chamber [[Size [6 5]] [Floor Lino] [Walls Paint] [Dado Dado]]]]

 ; the doors
 [Prop
  [[Name LaundryDoor]
   [Appearance [Some [Composed WoodenWallDoor []]]]
   [Place [[Against [Some East]] [Along 0]]]
   [Interact [Some [[InteractionType Open] [Cue [Enter [[To [Dorm EastCorridor]] [Style WoodenDoor]]]]]]]]]

 ; the lights
 [Prop
  [[Name Lamp]
   [Appearance [Some [Composed CeilingLamp [[Brightness [Some 1.8]]]]]]
   [Place [[At [Some [0 0]]] [Height [Some 2.7]]]]]]

 ; the cameras
 [Camera [[Zone [[-3 -2.5] [6 5]]] [At [2.5 2.75 2]] [LookAt [-1 0.4 -1]] [FieldOfView 70]]]

 ; the washers, the dryers, and dryer 3
 [Prop [[Name Washers] [Appearance [Some [Composed Washers [[Count [Some 4]]]]]] [Place [[At [Some [-0.3 -2.18]]]]]]]
 [Prop [[Name Dryers] [Appearance [Some [Composed Washers []]]] [Place [[At [Some [-2.68 0.4]]] [Facing 90]]]]]

 [Prop
  [[Name DryerThree]
   [Place [[At [Some [-2.68 1.1]]]]]
   [Interact
    [Some
     [[InteractionType Examine]
      [Cue
       [If
        [Flagged [Taken LaundryId]]
        [Say ["Dryer 3. Just the hoodie, and lint."]]
        [Sequence
         [[Say ["Dryer 3. A hoodie's still in the drum - and in its pocket, a student ID on a lanyard."]] [GiveAs LaundryId StudentId 1]]]]]]]]]]

 [Prop
  [[Name FoldingTable]
   [Appearance [Some [Composed Desk [[Colors [Some [[Wood Table] [Top Table]]]] [Stretch [Some [1.6 1 0.7]]]]]]]
   [Place [[At [Some [0.8 1.5]]]]]]]

 ; the pickups
 [Prop
  [[Name LaundryBullets]
   [Place [[At [Some [0.4 1.5]]] [Height [Some 0.79]]]]
   [Interact [Some [[InteractionType Take] [Cue [PickUp [[Item HandgunBullets] [Count 12]]]]]]]]]

 ; the creatures
 [Enemy [[Name LaundryStudent] [Creature Student] [Place [[At [Some [-1.3 -1.4]]] [Facing 270]]]]]
 [Enemy [[Name LaundryStudentLying] [Creature Student] [Place [[At [Some [-1 0.2]]] [Facing 20]]] [Lying True]]]]
