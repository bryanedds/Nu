; Appearances composed of parts for the hospital's rooms, each placed in a scene as [Composed Name settings].

[
 ; a door in a wall, in its frame - its origin at the wall, the door flush with it and its frame standing out round it,
 ; set into the wall a little so no gap shows behind it
 [Compose WoodenWallDoor
  [[Colors [[Frame [0.2 0.22 0.22 1]]
            [Door [0.4 0.3 0.2 1]]]]
   [Depth [0 0.1]]
   [Pieces [[Part [[Surface Paint] [Shape PartBox] [At [-0.55 1.11 0.016]] [Size [0.1 2.22 0.052]] [Color Frame]]]
            [Part [[Surface Paint] [Shape PartBox] [At [0.55 1.11 0.016]] [Size [0.1 2.22 0.052]] [Color Frame]]]
            [Part [[Surface Paint] [Shape PartBox] [At [0 2.16 0.016]] [Size [1.2 0.12 0.052]] [Color Frame]]]
            [Part [[Surface Wood] [Shape PartBox] [At [0 1.048 0.01]] [Size [0.996 2.096 0.016]] [Color Door] [Swings True]]]]]]]

