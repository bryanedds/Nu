 ; a typewriter - its body, the deck of keys sloping down in front of it, the carriage behind with its rubber platen
 ; and return lever, and a sheet of paper in it; its origin beneath its middle, its keys facing +z
 [Compose Typewriter
  [[Colors [[Body [0.18 0.2 0.18 1]]
            [Keys [0.78 0.76 0.68 1]]
            [Platen [0.06 0.06 0.06 1]]
            [Chrome [0.62 0.63 0.65 1]]
            [Paper [0.9 0.88 0.82 1]]]]
   [Depth [0.16 0.16]]
   [Pieces [[Part [[Surface Plastic] [Shape PartBox] [At [0 0.05 -0.02]] [Size [0.4 0.1 0.24]] [Color Body]]]
            [Part [[Surface Plastic] [Shape PartBox] [At [0 0.035 0.12]] [Size [0.38 0.04 0.1]] [Turn [0 12 0]] [Color Body]]]
            [Part [[Surface Plastic] [Shape PartBox] [At [0 0.065 0.12]] [Size [0.34 0.02 0.08]] [Turn [0 12 0]] [Color Keys]]]
            [Part [[Surface Plastic] [Shape PartBox] [At [0 0.12 -0.09]] [Size [0.46 0.04 0.07]] [Color Body]]]
            [Part [[Surface Rubber] [Shape PartCylinder] [At [0 0.15 -0.09]] [Size [0.045 0.44 0.045]] [Turn [0 0 90]] [Color Platen]]]
            [Part [[Surface Chrome] [Shape PartBox] [At [-0.25 0.15 -0.06]] [Size [0.012 0.012 0.07]] [Color Chrome]]]
            [Part [[Surface Paint] [Shape PartBox] [At [0 0.22 -0.1]] [Size [0.21 0.15 0.004]] [Turn [0 -12 0]] [Color Paper]]]]]]]

 ; a ceiling lamp's panel and its light, casting shadows and running on the power - dim and flickering until it's
 ; restored; its origin at the light, a little below the ceiling
 [Compose CeilingLamp
  [[Colors [[Panel [0.92 0.96 1 1]]
            [Lamplight [0.92 0.96 1 1]]]]
   [Depth [0.15 0.15]] [Height 2.7]
   [Pieces [[Part [[Surface Light] [Shape PartBox] [At [0 0.27 0]] [Size [1.2 0.04 0.3]] [Color Panel] [Flat True] [Glow [Some 3]] [Powered True]]]
            [Shine [[At [0 0 0]] [Color Lamplight] [Brightness 2] [Reach 8] [Shadowed True] [Powered True]]]]]]]

 ; a desk or counter, a meter each way unless stretched - its body, solid as a whole, and its top
 [Compose Desk
  [[Colors [[Wood [0.36 0.3 0.24 1]]
            [Top [0.75 0.74 0.7 1]]]]
   [Depth [0.5 0.5]]
   [Pieces [[Part [[Surface Wood] [Shape PartBox] [At [0 0.38 0]] [Size [1 0.76 1]] [Color Wood] [Stretches True]]]
            [Part [[Surface Plastic] [Shape PartBox] [At [0 0.775 0]] [Size [1.03 0.03 1.05]] [Color Top] [Stretches True]]]
            [SolidBox [0 0] [0.5 0.5]]]]]]

