 ; the van, ticking as it cools by the east wall, and the trailer left unhitched along the west one, out of the way of the
 ; eye's view of the dock
 [Prop [[Name Van] [Appearance [Some [Composed Van []]]] [Place [[At [Some [4.8 2]]]]]
   [Interact [Some [[InteractionType Examine] [Cue [Say ["The facilities van, ticking as it cools. The needle's on empty again - it's done its part."]]]]]]]]
 [Prop [[Name Trailer] [Appearance [Some [Composed Trailer []]]] [Place [[At [Some [-4.6 1.4]]] [Facing 90]]]]]
 [Prop [[Name CompanySign] [Appearance [Some [Slab [[Size [3 0.6 0.04]] [Surface Paint] [Tint Sign]]]]] [Place [[Against [Some North]] [Along -3] [Height [Some 2.2]]]]
   [Interact [Some [[InteractionType Examine] [Cue [Say ["BRANDT PACKING CO. - QUALITY MEATS SINCE 1931. Someone's sprayed under it: THE TRAIN STOPS OUT BACK."]]]]]]]]
 ; the gate onto the platform, chained from the far side
 [Prop [[Name PlatformGate] [Appearance [Some [Slab [[Size [0.06 2.2 2.4]] [Surface Steel] [Tint Fence]]]]] [Place [[At [Some [5.97 -2.5]]] [Height [Some 0]]]]
   [Interact [Some [[InteractionType Examine] [Cue [Say ["A chain-link gate onto the rail platform behind the plant, chained and padlocked from the other side." "Through it, the tracks run off into the dark. The way round's through the plant."]]]]]]]]
 [Prop [[Name YardShells] [Place [[At [Some [5.2 -4.2]]] [Height [Some 0.01]]]]
