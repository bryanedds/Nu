; The kill floor - long and cold, sides of beef hung in rows from the overhead rails, the scald tank steaming at the far
; end, and doors off it to the lockers, the grinding room and cold storage, and the rendering room chained shut.

[[Palette [[Tile [0.55 0.56 0.54 1]] [Paint [0.62 0.64 0.62 1]] [Dado [0.5 0.12 0.1 1]] [Drain [0.3 0.08 0.06 1]]]]

 [Area
  [[Type [Plant KillFloor]]
   [Name "Kill Floor"]
   [Ambient 0.75]
   [Probe [0 1.6 0]]
   [Bounds [[-4.5 -0.5 -8.5] [9 4 17]]]
   [Songs [[[Song PlantSong]]]]]]

 [Layout
  [Chamber [[Size [8 16]] [Floor Tile] [Walls Paint] [Dado Dado] [FloorSurface [Some Tile]] [WallSurface [Some Tile]]]]]

 ; the doors
 [Prop
  [[Name DockKillDoors]
   [Appearance [Some [Composed DoubleWallDoor []]]]
   [Place [[Against [Some South]] [Along 1.5]]]
   [Interact [Some [[InteractionType Open] [Cue [Enter [[To [Plant Dock]] [Style DoubleDoor]]]]]]]]]

 [Prop
  [[Name KillLockersDoor]
   [Appearance [Some [Composed WoodenWallDoor []]]]
   [Place [[Against [Some West]] [Along 3]]]
   [Interact [Some [[InteractionType Open] [Cue [Enter [[To [Plant Lockers]] [Style WoodenDoor]]]]]]]]]

 [Prop
  [[Name KillGrinderDoors]
   [Appearance [Some [Composed DoubleWallDoor []]]]
   [Place [[Against [Some East]] [Along 1]]]
   [Interact [Some [[InteractionType Open] [Cue [Enter [[To [Plant Grinder]] [Style DoubleDoor]]]]]]]]]

 [Prop
  [[Name KillColdDoor]
   [Appearance [Some [Composed SteelWallDoor []]]]
   [Place [[Against [Some West]] [Along -4.5]]]
   [Interact
    [Some
     [[InteractionType Open]
      [Cue
       [Enter
        [[To [Plant ColdStorage]]
         [Style SteelDoor]
         [Opens [Some [Flagged [Examined BoilerValve]]]]
         [Locked [Some "Cold storage. Its door's frozen solid in its frame, the seals crusted thick with ice. Something would have to thaw it."]]]]]]]]]]

 [Prop
  [[Name RenderingDoor]
   [Appearance [Some [Composed SteelWallDoor []]]]
   [Place [[Against [Some North]] [Along 0]]]
   [Interact
    [Some
     [[InteractionType Open]
      [Cue
       [Enter
        [[To [Plant Rendering]]
         [Style SteelDoor]
         [Key [Some BoltCutters]]
         [Locked [Some "Chained shut, a padlock through the handles. Stencilled on the steel: RENDERING - NO ENTRY."]]]]]]]]]]

