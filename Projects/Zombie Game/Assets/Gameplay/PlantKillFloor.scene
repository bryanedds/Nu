  [[Name KillBullets]
   [Place [[At [Some [-3.4 -1]]] [Height [Some 0.01]]]]
   [Interact [Some [[InteractionType Take] [Cue [PickUp [[Item HandgunBullets] [Count 15]]]]]]]]]

 [Prop
