 ; the scald tank, steaming at the far end
 [Prop
  [[Name ScaldTank]
   [Appearance [Some [Composed Vat []]]]
   [Place [[At [Some [2.9 -6.6]]]]]
   [Interact
    [Some
     [[InteractionType Examine]
      [Cue [Say ["The scald tank, still steaming. Its dial's set where it always is - 140." "Something pale turns over slowly under the surface."]]]]]]]]

